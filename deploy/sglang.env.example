# SGLang 런타임 설정 — install.sh 가 deploy/sglang.env 로 복사함
# 값 바꾼 후 `sudo systemctl restart sglang` 으로 반영

# 모델 경로 (HuggingFace Hub ID 또는 로컬 경로)
SGLANG_MODEL_PATH=google/gemma-3-27b-it

# 클라이언트에서 사용할 모델 이름 (.env 의 AI_MODEL 과 일치시킬 것)
SGLANG_SERVED_NAME=gemma

# OpenAI 호환 서버 포트
SGLANG_PORT=30000

# 바인딩 호스트 (127.0.0.1 = 같은 머신만 접근, 0.0.0.0 = 외부 노출 — 방화벽 주의)
SGLANG_HOST=127.0.0.1

# 추가 인자 — DGX Spark 128GB 통합 메모리 활용 예시
# FP8 양자화: --quantization fp8
# 컨텍스트 길이 늘리기: --context-length 32768
# GPU 메모리 분율: --mem-fraction-static 0.85
SGLANG_EXTRA_ARGS=

# Python venv 위치 (install.sh 가 여기에 SGLang 을 설치)
SGLANG_VENV=__HOME__/sglang-env

# HuggingFace 토큰 (Gemma 같은 게이트 모델 다운로드용; 없으면 빈 값)
HUGGING_FACE_HUB_TOKEN=
