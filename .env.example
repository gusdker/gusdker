# ===== Shopify =====
# 예: my-shop.myshopify.com  (https:// 빼고 도메인만)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Custom App의 Admin API access token (shpat_ 로 시작)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
# API 버전 (예: 2025-01)
SHOPIFY_API_VERSION=2025-01

# ===== Claude (Anthropic) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
# 사용 모델 (선택, 기본값: claude-opus-4-7)
ANTHROPIC_MODEL=claude-opus-4-7

# ===== 운영 옵션 =====
# debug, info, warn, error
LOG_LEVEL=info
# 데이터/리포트 저장 경로 (기본: ./data)
DATA_DIR=./data

# ===== Korealy (옵션) =====
# Korealy 푸시 후 후처리 활성화 여부
KOREALY_ENABLED=true

# ===== 리뷰 수집 (옵션, 추후) =====
REVIEWS_ENABLED=false
