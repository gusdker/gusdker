# ===== Shopify =====
# 예: my-shop.myshopify.com  (https:// 빼고 도메인만)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Custom App의 Admin API access token (shpat_ 로 시작)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
# API 버전 (기본: 2025-01)
SHOPIFY_API_VERSION=2025-01

# ===== AI 공급자 =====
# 옵션: anthropic | openai-compat | none
# 미설정 시 AI_BASE_URL 있으면 openai-compat, ANTHROPIC_API_KEY 있으면 anthropic 으로 자동 감지
AI_PROVIDER=openai-compat

# --- openai-compat 사용 시 (Ollama / LM Studio / SGLang / vLLM 등) ---
# SGLang 기본: http://localhost:30000/v1
# Ollama 기본: http://localhost:11434/v1
# LM Studio 기본: http://localhost:1234/v1
AI_BASE_URL=http://localhost:30000/v1
# SGLang 실행 시 지정한 served model 이름 (예: gemma 또는 gemma3-27b-it 등)
AI_MODEL=gemma
# 로컬은 보통 불필요. 필요한 경우만 입력
AI_API_KEY=not-needed

# --- anthropic 사용 시 ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-opus-4-7

# ===== 운영 옵션 =====
# debug, info, warn, error
LOG_LEVEL=info
# 데이터/리포트 저장 경로 (기본: ./data)
DATA_DIR=./data

# ===== Korealy (옵션, 추후) =====
KOREALY_ENABLED=true

# ===== 리뷰 수집 (옵션, 추후) =====
REVIEWS_ENABLED=false
